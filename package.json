{
  "name": "dg-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A diffenderfer.games game on the dg-template kit (TypeScript + Vite; PixiJS, three.js or DOM).",
  "author": "your name here",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/kit/build-rules.ts && node scripts/kit/build-live.ts",
    "preview": "vite preview --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --project kit --project hub-events --project game",
    "test:slow": "vitest run --project slow --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier -w \"**/*.{ts,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,json,css,html}\"",
    "check": "node scripts/kit/check.ts",
    "kit:check": "node scripts/kit/kit-check.ts",
    "kit:sync": "node scripts/kit/kit-sync.ts",
    "kit:hash": "node scripts/kit/kit-hash.ts",
    "todo": "node scripts/kit/todo.ts",
    "sync-docs": "node scripts/kit/sync-docs.ts",
    "sync-hub-server": "node scripts/kit/sync-hub-server.ts",
    "hub-doctor": "hub-doctor",
    "new-game": "node scripts/kit/new-game.ts",
    "create": "node scripts/kit/create.ts",
    "first-deploy": "node scripts/kit/first-deploy.ts",
    "build:rules": "node scripts/kit/build-rules.ts",
    "build:live": "node scripts/kit/build-live.ts",
    "world:check": "node scripts/kit/world.ts check",
    "world:generate": "node scripts/kit/world.ts generate",
    "world:tiled": "node scripts/kit/world.ts tiled",
    "world:build": "node scripts/kit/world.ts build",
    "test:hub": "node scripts/kit/test-hub.ts",
    "shots": "node scripts/kit/shots.ts",
    "shots:hub": "node scripts/kit/shots.ts --hub",
    "shots:sheet": "node scripts/kit/sheet.ts",
    "cover": "node scripts/kit/cover.ts",
    "sim": "node scripts/sim.ts",
    "local": "node scripts/kit/local.ts",
    "probe": "node scripts/kit/probe.ts",
    "ui:check": "node scripts/kit/ui-check.ts",
    "clean:procs": "node scripts/kit/clean-procs.ts"
  },
  "game": {
    "type": "static",
    "title": "My Game",
    "description": "TODO: one plain sentence about the game.",
    "labels": [
      "arcade",
      "2d",
      "phone",
      "controller",
      "single-player",
      "multiplayer"
    ],
    "ages": {
      "min": 6
    },
    "build": "npm run build",
    "serveDir": "dist",
    "menuPosition": "top-right",
    "image": "cover.png",
    "embed": {
      "supported": true,
      "size": [
        960,
        640
      ]
    },
    "resumable": true,
    "dailyChallenges": true,
    "leaderboards": [
      {
        "key": "high",
        "title": "High score"
      }
    ],
    "race": {
      "params": [],
      "stats": [
        {
          "key": "score",
          "title": "Score"
        }
      ],
      "minMs": 3000
    },
    "multiplayer": {
      "lobby": "?mp=lobby",
      "players": [
        2,
        4
      ],
      "transport": "hub-rooms",
      "spectate": true,
      "modes": [
        {
          "key": "party",
          "title": "Party"
        }
      ]
    },
    "turns": {
      "rules": "dist-rules/rules.mjs",
      "players": [
        2,
        4
      ],
      "bots": true,
      "quickChat": [
        "Good move!",
        "Your move!",
        "Last one!"
      ]
    },
    "world": {
      "generate": {
        "type": "lounge",
        "needs": {
          "tables": 4,
          "game": "My Game"
        }
      }
    },
    "changes": []
  },
  "dependencies": {
    "@diffenderfer-games/hub": "2.0.0-next.14",
    "pixi.js": "^8.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@diffenderfer-games/world": "2.0.0-next.13",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
